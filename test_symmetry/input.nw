start test_fcc
permanent_dir ./perm
scratch_dir ./scratch

geometry "FCC Cu" units angstroms
 system crystal
  lat_a 3.615
  lat_b 3.615
  lat_c 3.615
  alpha 90.0
  beta  90.0
  gamma 90.0
 end
 Cu  0.0  0.0  0.0
 Cu  0.5  0.5  0.0
 Cu  0.5  0.0  0.5
 Cu  0.0  0.5  0.5
end

nwpw
 simulation_cell
  fcc 3.615
 end
 cutoff 30.0
 smear fermi 0.01
 monkhorst-pack 4 4 4
 tolerances 1e-6 1e-6 1e-6
end

task pspw energy
