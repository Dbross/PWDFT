echo

title "pwdft"

permanent_dir ./perm

scratch_dir ./perm

start pwdft

geometry units angstrom nocenter noautosym noautoz
  system crystal units angstrom
    lattice_vectors
      3.6000000000000001e+00 0.0000000000000000e+00 0.0000000000000000e+00
      0.0000000000000000e+00 3.6000000000000001e+00 0.0000000000000000e+00
      0.0000000000000000e+00 0.0000000000000000e+00 3.6000000000000001e+00
  end
  Cu 0.0000000000000000e+00 0.0000000000000000e+00 0.0000000000000000e+00
  Cu 5.0000000000000000e-01 5.0000000000000000e-01 0.0000000000000000e+00
  Cu 5.0000000000000000e-01 0.0000000000000000e+00 5.0000000000000000e-01
  Cu 0.0000000000000000e+00 5.0000000000000000e-01 5.0000000000000000e-01
end

cutoff 60.0
nwpw
  2d-hcurve
  lmbfgs
  scf ks-grassmann-cg anderson alpha 0.15
  smear methfessel-paxton
  temperature 300
  loop 20 20
  monkhorst-pack 3 3 1
  xc pbe96
  mult 1
end



task band energy

