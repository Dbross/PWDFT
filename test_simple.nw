title "Simple Test - Adaptive Threshold"

# Enable adaptive diagonalization threshold
nwpw
   scf_adaptive_threshold true
   scf_initial_ethr 1.0e-2
   scf_min_ethr 1.0e-13
   scf_ethr_factor 0.1
   minimizer 3
   loop 5 20
   tolerances 1.0e-6 1.0e-6 1.0e-4
   scf_algorithm 0
   scf_alpha 0.25
   print medium
end

# Simple H2 molecule
geometry
   H 0.0 0.0 0.0
   H 1.4 0.0 0.0
end

# Basic simulation cell
simulation_cell
   boundary_conditions periodic
   lattice_vectors
      10.0 0.0 0.0
      0.0 10.0 0.0
      0.0 0.0 10.0
   end
end

# XC functional
xc pbe

# Pseudopotentials
pseudopotentials
   H library1/H.psp
end

# Task
task pspw energy 