Title "Clean Pt(111) Slab Test"

memory 2000 mb
start pt-slab
echo

geometry noautosym noautoz center
Pt 0.00 0.00 0.00
Pt 2.82 1.63 0.00
Pt 0.00 3.25 0.00
Pt 2.82 4.88 0.00
Pt 0.00 0.00 2.26
Pt 2.82 1.63 2.26
Pt 0.00 3.25 2.26
Pt 2.82 4.88 2.26
Pt 0.00 0.00 4.52
end

nwpw
   pseudopotentials
   Pt library pspw_default
   end
   simulation_cell
     SC 20.0
   end
   mapping 1
   cutoff 30.0 120.0
   xc pbe
   steepest_descent
      time_step 5.0
      loop 20 200
   end
end

task pspw energy 