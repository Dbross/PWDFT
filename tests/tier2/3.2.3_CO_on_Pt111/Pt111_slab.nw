# PWDFT input for clean Pt(111) slab
# Purpose: Part of the adsorption energy calculation for CO on Pt(111)
start Pt111_slab

&CONTROL
  calculation = 'scf'
  prefix = 'pt_slab'
  outdir = './tmp/'
/

&SYSTEM
  ibrav = 0
  nat = 9
  ntyp = 1
  ecutwfc = 40.0
  ecutrho = 200.0
  occupations = 'smearing'
  smearing = 'marzari-vanderbilt'
  degauss = 0.01
/

&ELECTRONS
  mixing_beta = 0.3
/

CELL_PARAMETERS (angstrom)
  5.64  0.00  0.00
 -2.82  4.88  0.00
  0.00  0.00 20.00

ATOMIC_SPECIES
  Pt 195.08  Pt.pbe-rrkjus.UPF

ATOMIC_POSITIONS (angstrom)
  Pt  0.00  0.00  0.00  1 1 1
  Pt  2.82  1.63  0.00  1 1 1
  Pt  0.00  3.25  0.00  1 1 1
  Pt  2.82  4.88  0.00  1 1 1
  Pt  0.00  0.00  2.26  1 1 1
  Pt  2.82  1.63  2.26  1 1 1
  Pt  0.00  3.25  2.26  1 1 1
  Pt  2.82  4.88  2.26  1 1 1
  Pt  0.00  0.00  4.52  1 1 1

K_POINTS automatic
  4 4 1 0 0 0 