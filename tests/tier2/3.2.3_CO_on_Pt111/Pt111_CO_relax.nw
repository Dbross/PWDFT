Title "CO on Pt(111) Adsorption Test"

memory 2000 mb
start pt-co-relax
echo

geometry noautosym noautoz center
Pt 0.00 0.00 0.00
Pt 2.82 1.63 0.00
Pt 0.00 3.25 0.00
Pt 2.82 4.88 0.00
Pt 0.00 0.00 2.26
Pt 2.82 1.63 2.26
Pt 0.00 3.25 2.26
Pt 2.82 4.88 2.26
Pt 0.00 0.00 4.52
C 0.00 0.00 8.00
O 0.00 0.00 9.14
end

nwpw
   pseudopotentials
   Pt library pspw_default
   C library pspw_default
   O library pspw_default
   end
   simulation_cell
     SC 20.0
   end
   mapping 1
   cutoff 25.0 100.0
   xc pbe
   tolerances 1.0e-5 1.0e-5
   initial_wavefunction_guess superposition
   loop 20 200
end

task pspw energy 