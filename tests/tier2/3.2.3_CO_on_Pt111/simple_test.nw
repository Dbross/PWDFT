Title "Simple Pt Test"

memory 1000 mb
start simple-pt
echo

geometry noautosym noautoz center
Pt 0.00 0.00 0.00
Pt 2.82 0.00 0.00
end

nwpw
   pseudopotentials
   Pt library pspw_default
   end
   simulation_cell
     SC 15.0
   end
   mapping 1
   cutoff 25.0 100.0
   xc pbe
   tolerances 1.0e-5 1.0e-5
   loop 10 50
end

task pspw energy 