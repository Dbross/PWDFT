# PWDFT input for gas-phase CO molecule
# Purpose: Part of the adsorption energy calculation for CO on Pt(111)
start CO_gas

&CONTROL
  calculation = 'scf'
  prefix = 'co_gas'
  outdir = './tmp/'
/

&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 2
  ecutwfc = 40.0
  ecutrho = 200.0
/

&ELECTRONS
  mixing_beta = 0.7
/

CELL_PARAMETERS (angstrom)
 15.0  0.0  0.0
  0.0 15.0  0.0
  0.0  0.0 15.0

ATOMIC_SPECIES
 C 12.011 C.pbe-rrkjus.UPF
 O 15.999 O.pbe-rrkjus.UPF

ATOMIC_POSITIONS (angstrom)
 C 0.0 0.0 0.0
 O 0.0 0.0 1.14

K_POINTS gamma 