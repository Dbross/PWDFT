Title "Gas-Phase CO Molecule Test"

memory 1000 mb
start co-gas
echo

geometry noautosym noautoz center
C 0.0 0.0 0.0
O 0.0 0.0 1.14
end

nwpw
   pseudopotentials
   C library pspw_default
   O library pspw_default
   end
   simulation_cell
     SC 15.0
   end
   mapping 1
   cutoff 30.0 120.0
   xc pbe
   steepest_descent
      time_step 5.0
      loop 20 200
   end
end

task pspw energy 