Title "Si Variable-Cell Relaxation Test"

memory 2000 mb
start si-vcrelax
echo

geometry noautosym noautoz center
Si 0 0 0
Si 2.715 2.715 2.715
end

nwpw
   pseudopotentials
   Si library pspw_default
   end
   simulation_cell
     SC 10.52
   end
   mapping 1
   cutoff 30.0
   xc lda
   steepest_descent
      time_step 5.0
      geometry_optimize
      loop 20 200
   end
end

task pspw steepest_descent 