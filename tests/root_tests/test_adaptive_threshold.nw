title "Test Adaptive Diagonalization Threshold"

# Enable adaptive diagonalization threshold
nwpw
   scf_adaptive_threshold true
   scf_initial_ethr 1.0e-2
   scf_min_ethr 1.0e-13
   scf_ethr_factor 0.1
end

# Standard SCF parameters
nwpw
   minimizer 3
   loop 10 50
   tolerances 1.0e-7 1.0e-7 1.0e-4
   scf_algorithm 2
   scf_alpha 0.25
   scf_beta 0.1
   diis_histories 10
   print medium
end

# Simple water molecule test
geometry
   O 0.0 0.0 0.0
   H 0.957 0.0 0.0
   H -0.24 0.927 0.0
end

# Basic simulation cell
simulation_cell
   boundary_conditions periodic
   lattice_vectors
      15.0 0.0 0.0
      0.0 15.0 0.0
      0.0 0.0 15.0
   end
end

# XC functional
xc pbe

# Pseudopotentials
pseudopotentials
   O library1/O.psp
   H library1/H.psp
end

# Task
task pspw energy 