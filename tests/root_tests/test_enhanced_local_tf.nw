title "Enhanced Local-TF Preconditioning Test - Silicon Surface"

geometry
  Si 0.0 0.0 0.0
  Si 0.5 0.5 0.0
  Si 0.0 0.5 0.5
  Si 0.5 0.0 0.5
  Si 0.25 0.25 0.25
  Si 0.75 0.75 0.25
  Si 0.25 0.75 0.75
  Si 0.75 0.25 0.75
end

nwpw
  print high
  simulation_cell
    boundary_conditions periodic
    unita 10.0 0.0 0.0
             0.0 10.0 0.0
             0.0 0.0 20.0  # Extended in z-direction for surface-like system
  end
  xc pbe
  loop 10 100
  tolerances 1.0e-6 1.0e-6 1.0e-4
  
  # Enhanced Local-TF mixing parameters
  mixing_algorithm 4  # Local-TF mixing with enhanced preconditioning
  mixing_alpha 0.25
  mixing_beta 0.20   # Conservative value for surface systems
  mixing_ndim 8
end

task pspw energy 