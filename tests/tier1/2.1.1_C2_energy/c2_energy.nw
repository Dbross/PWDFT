Title "C2 Molecule Energy Test"

memory 1000 mb
start c2-energy
echo

geometry noautosym noautoz center
C 0 0 0    
C 0 0 1.3  
end

nwpw
   pseudopotentials
   C library pspw_default
   end
   simulation_cell
     SC 10.0
   end
   mapping 1
   cutoff 40.0
   xc pbe
   scf_alpha 0.25
   scf_beta 0.1
   diis_histories 10
   steepest_descent
      time_step 5.0
      loop 10 100
   end
end

task pspw energy 