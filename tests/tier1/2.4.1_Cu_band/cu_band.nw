Title "Simple Band Calculation Test"

memory 1000 mb
start simple-band
echo

geometry noautoz nocenter noautosym
system crystal
   lattice_vectors
     10.0 0.000000 0.000000
     0.000000 10.0 0.000000
     0.000000 0.000000 10.0
end

H 0.0 0.0 0.3705
H 0.0 0.0 -0.3705
end

nwpw
   pseudopotentials
   H library pspw_default
   end
   xc pbe96
   cutoff 20.0
   smear methfessel-paxton
   temperature 300
   loop 10 20
   monkhorst-pack 2 2 2
   tolerances 1.0e-6 1.0e-6 1.0e-4
end

task pspw energy 