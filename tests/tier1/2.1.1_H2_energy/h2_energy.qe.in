&CONTROL
   calculation = 'scf'
   restart_mode = 'from_scratch'
   prefix = 'h2-energy'
   pseudo_dir = './'
   outdir = './'
   disk_io = 'low'
   verbosity = 'high'
   tprnfor = .true.
   tstress = .true.
/

&SYSTEM
   ibrav = 1
   celldm(1) = 18.8973
   nat = 2
   ntyp = 1
   ecutwfc = 40.0
   ecutrho = 160.0
   occupations = 'smearing'
   smearing = 'gaussian'
   degauss = 0.01
   nspin = 1
   tot_charge = 0.0
   tot_magnetization = 0.0
   input_dft = 'PBE'
   exx_fraction = 0.0
   screening_parameter = 0.0
   exxdiv_treatment = 'gygi-baldereschi'
   x_gamma_extrapolation = .true.
   assume_isolated = 'molecule'
/

&ELECTRONS
   electron_maxstep = 100
   conv_thr = 1.0d-7
   conv_thr_ion = 1.0d-4
   mixing_mode = 'plain'
   mixing_beta = 0.25
   mixing_ndim = 10
   diagonalization = 'david'
   diago_thr_init = 1.0d-4
   diago_cg_maxiter = 20
   diago_david_ndim = 4
   diago_full_acc = .true.
   startingpot = 'atomic'
   startingwfc = 'atomic+random'
/

ATOMIC_SPECIES
H   1.00794  H.pbe-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS {angstrom}
H   0.000000   0.000000   0.370500
H   0.000000   0.000000  -0.370500

K_POINTS {gamma} 