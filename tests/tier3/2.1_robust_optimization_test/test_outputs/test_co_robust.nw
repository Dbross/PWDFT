title "CO molecule - Robust optimization test"

start co_robust

geometry
  C     0.00000000    0.00000000    0.00000000
  O     0.00000000    0.00000000    1.13000000
end

basis
  * library 6-31G
end

dft
  xc pbe
  grid medium
  convergence energy 1e-6
  convergence density 1e-5
  convergence gradient 1e-4
end

driver
  clear
  maxiter 100
  gmax 0.0001
  grms 0.0001
  xrms 0.0001
  xmax 0.0001
end

task dft optimize
