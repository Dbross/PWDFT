title "CO adsorption on Pt(111) - Robust optimization test"

start co_pt_robust

geometry
  # Pt atoms (simplified Pt(111) surface)
  Pt    0.00000000    0.00000000    0.00000000
  Pt    2.77500000    0.00000000    0.00000000
  Pt    1.38750000    2.40300000    0.00000000
  Pt    4.16250000    2.40300000    0.00000000
  Pt    0.00000000    4.80600000    0.00000000
  Pt    2.77500000    4.80600000    0.00000000
  # CO molecule
  C     1.38750000    1.20150000    2.00000000
  O     1.38750000    1.20150000    3.20000000
end

basis
  * library 6-31G
end

dft
  xc pbe
  grid medium
  convergence energy 1e-6
  convergence density 1e-5
  convergence gradient 1e-4
end

driver
  clear
  maxiter 150
  gmax 0.0001
  grms 0.0001
  xrms 0.0001
  xmax 0.0001
end

task dft optimize
