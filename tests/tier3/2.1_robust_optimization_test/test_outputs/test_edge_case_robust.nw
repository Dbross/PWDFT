title "Edge case - Very small step sizes"

start edge_case_robust

geometry
  H    0.00000000    0.00000000    0.00000000
  H    0.00000000    0.00000000    0.74000000
end

basis
  * library 6-31G
end

dft
  xc pbe
  grid medium
  convergence energy 1e-8
  convergence density 1e-7
  convergence gradient 1e-6
end

driver
  clear
  maxiter 200
  gmax 0.00001
  grms 0.00001
  xrms 0.00001
  xmax 0.00001
end

task dft optimize
