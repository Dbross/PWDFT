title "Original Local-TF Test - Water Molecule"

geometry
  O 0.0 0.0 0.0
  H 0.957 0.0 0.0
  H -0.24 0.927 0.0
end

nwpw
  print medium
  simulation_cell
    boundary_conditions periodic
    unita 12.0 0.0 0.0
             0.0 12.0 0.0
             0.0 0.0 12.0
  end
  xc pbe
  loop 5 20
  tolerances 1.0e-4 1.0e-4 1.0e-4
  
  # Original Local-TF mixing
  mixing_algorithm 4
  mixing_alpha 0.25
  mixing_beta 0.10
  mixing_ndim 4
end

task pspw energy
