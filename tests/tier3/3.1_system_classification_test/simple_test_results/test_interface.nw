print medium
title "Si/Si Interface Test"

geometry noautoz nocenter noautosym
# Si/Si interface - layered structure (simplified)
# Bottom layer
Si 0.0 0.0 0.0
Si 2.715 2.715 0.0
Si 0.0 5.43 0.0
Si 2.715 8.145 0.0
# Top layer
Si 0.0 0.0 2.715
Si 2.715 2.715 2.715
Si 0.0 5.43 2.715
Si 2.715 8.145 2.715
end

nwpw
   pseudopotentials
   Si library pspw_default
   end
   simulation_cell
     SC 25.0
   end
   mapping 1
   cutoff 35.0
   xc pbe
   loop 1 1  # Early termination
end

task pspw energy
