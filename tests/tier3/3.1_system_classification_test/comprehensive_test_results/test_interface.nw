print medium
title "Cu/Al Interface Test"

geometry noautoz nocenter noautosym
# Cu/Al interface - layered structure
# Cu layer
Cu 0.0 0.0 0.0
Cu 2.55 0.0 0.0
Cu 0.0 2.55 0.0
Cu 2.55 2.55 0.0
# Al layer
Al 0.0 0.0 2.55
Al 2.55 0.0 2.55
Al 0.0 2.55 2.55
Al 2.55 2.55 2.55
end

nwpw
   pseudopotentials
   Cu library pspw_default
   Al library pspw_default
   end
   simulation_cell
     SC 20.0
   end
   mapping 1
   cutoff 30.0
   xc pbe
   loop 1 1  # Early termination
end

task pspw energy
