print medium
title "C Diamond Bulk Insulator Test"

geometry noautoz nocenter noautosym
# C diamond - simple cubic structure (8 atoms)
C 0.0 0.0 0.0
C 3.57 0.0 0.0
C 0.0 3.57 0.0
C 3.57 3.57 0.0
C 0.0 0.0 3.57
C 3.57 0.0 3.57
C 0.0 3.57 3.57
C 3.57 3.57 3.57
end

nwpw
   pseudopotentials
   C library pspw_default
   end
   simulation_cell
     SC 20.0
   end
   mapping 1
   cutoff 30.0
   xc pbe
   loop 1 1  # Early termination
end

task pspw energy
