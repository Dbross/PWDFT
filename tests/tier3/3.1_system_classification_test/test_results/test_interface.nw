print medium
title "Cu/O Interface Test"

geometry noautoz nocenter noautosym
# Cu/O interface - layered structure
# Cu layer
Cu 0.0 0.0 0.0
Cu 2.55 0.0 0.0
Cu 0.0 2.55 0.0
Cu 2.55 2.55 0.0
Cu 5.1 0.0 0.0
Cu 7.65 2.55 0.0
Cu 5.1 5.1 0.0
Cu 7.65 7.65 0.0
# O layer
O 0.0 0.0 2.55
O 2.55 2.55 2.55
O 0.0 5.1 2.55
O 2.55 7.65 2.55
O 5.1 0.0 2.55
O 7.65 2.55 2.55
O 5.1 5.1 2.55
O 7.65 7.65 2.55
end

nwpw
   pseudopotentials
   Cu library pspw_default
   O library pspw_default
   end
   simulation_cell
     SC 20.0
   end
   mapping 1
   cutoff 30.0
   xc pbe
   loop 1 1  # Early termination
end

task pspw energy
