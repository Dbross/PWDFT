
echo

title "pwdft"
      
permanent_dir ./perm
      
scratch_dir ./perm
 
start pwdft
      
geometry units angstrom nocenter noautosym noautoz
  system crystal units angstrom
    lattice_vectors
      3.6 0.0 0.0
      0.0 3.6 0.0
      0.0 0.0 3.6
  end
  Cu 0.0 0.0 0.0
  Cu 0.5 0.5 0.0
  Cu 0.5 0.0 0.5
  Cu 0.0 0.5 0.5
end

cutoff 10.0
nwpw
  2d-hcurve
  lmbfgs
  scf ks-grassmann-cg anderson alpha 0.15
  smear methfessel-paxton
  temperature 300
  loop 1 1
  monkhorst-pack 1 1 1
end
